rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /visitas/{visitId} {
      // Crear únicamente estadísticas técnicas con estructura y límites conocidos.
      // El sitio público no puede leer, modificar ni borrar registros.
      allow create: if
        request.resource.data.keys().hasAll([
          'sessionId', 'privacyNoticeVersion', 'visitedAt', 'pagePath',
          'referrerHost', 'language', 'timeZone', 'screen', 'viewport',
          'device', 'deviceModel', 'formFactor',
          'browser', 'browserVersion', 'operatingSystem', 'platformVersion'
        ]) &&
        request.resource.data.keys().hasOnly([
          'sessionId', 'privacyNoticeVersion', 'visitedAt', 'pagePath',
          'referrerHost', 'language', 'timeZone', 'screen', 'viewport',
          'device', 'deviceModel', 'formFactor',
          'browser', 'browserVersion', 'operatingSystem', 'platformVersion'
        ]) &&
        request.resource.data.sessionId is string &&
        request.resource.data.sessionId.size() == 36 &&
        request.resource.data.privacyNoticeVersion is string &&
        request.resource.data.privacyNoticeVersion.size() <= 10 &&
        request.resource.data.visitedAt is timestamp &&
        request.resource.data.pagePath is string &&
        request.resource.data.pagePath.size() <= 300 &&
        request.resource.data.referrerHost is string &&
        request.resource.data.referrerHost.size() <= 150 &&
        request.resource.data.language is string &&
        request.resource.data.language.size() <= 35 &&
        request.resource.data.timeZone is string &&
        request.resource.data.timeZone.size() <= 80 &&
        request.resource.data.screen is string &&
        request.resource.data.screen.size() <= 20 &&
        request.resource.data.viewport is string &&
        request.resource.data.viewport.size() <= 20 &&
        request.resource.data.device in ['móvil', 'tablet', 'computadora'] &&
        request.resource.data.deviceModel is string &&
        request.resource.data.deviceModel.size() <= 100 &&
        request.resource.data.formFactor is string &&
        request.resource.data.formFactor.size() <= 60 &&
        request.resource.data.browser is string &&
        request.resource.data.browser.size() <= 40 &&
        request.resource.data.browserVersion is string &&
        request.resource.data.browserVersion.size() <= 30 &&
        request.resource.data.operatingSystem is string &&
        request.resource.data.operatingSystem.size() <= 40 &&
        request.resource.data.platformVersion is string &&
        request.resource.data.platformVersion.size() <= 40;

      allow read, update, delete: if false;
    }
  }
}
